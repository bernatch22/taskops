{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"]
  },
  "comment": "`smoke` is included on purpose: the harness renders the real components, so a prop contract that changes under it must be a compile error here and not a red suite an hour later.",
  "include": ["src", "smoke"]
}
