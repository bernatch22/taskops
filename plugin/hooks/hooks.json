{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -m taskops.transports.cli.main hook pre-tool-use" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -m taskops.transports.cli.main hook post-tool-use" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -m taskops.transports.cli.main hook session-start" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -m taskops.transports.cli.main hook stop" }
        ]
      }
    ]
  }
}
